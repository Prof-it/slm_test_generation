# Dockerfile for SLM Inference — RealWorldTests-Py v2
# Base: CUDA 12.1 image (proven to work on vast.ai CUDA 13 hosts via driver forward-compat)
# Python 3.10 from Ubuntu 22.04 (pip installs cu12x torch/vllm wheels which run on CUDA 13)
FROM nvidia/cuda:12.1.1-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# --- GPU / NCCL stability flags ---
# Disables Infiniband/P2P which causes hangs on consumer cloud GPUs (vast.ai, RunPod)
ENV NCCL_P2P_DISABLE=1
ENV NCCL_IB_DISABLE=1
# Prevents Ray/multiprocessing deadlocks under vllm
ENV VLLM_WORKER_MULTIPROC_METHOD=spawn

# HuggingFace cache on the persistent volume (set HF_TOKEN at runtime via env var)
ENV HF_HOME=/workspace/huggingface_cache

# --- System packages ---
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    git \
    python3.10 \
    python3-pip \
    python3-dev \
    htop \
    vim \
    strace \
    nvtop \
    procps \
    && rm -rf /var/lib/apt/lists/*

RUN ln -s /usr/bin/python3 /usr/bin/python

# --- Project setup ---
WORKDIR /app
COPY requirements.txt .

# Workaround: PyPI hash mismatch for cupy-cuda12x 13.6.0 (vllm -> ray[cgraph] dep).
# Download the wheel directly to bypass pip's hash check.
RUN python3 -c "import urllib.request; urllib.request.urlretrieve( \
    'https://files.pythonhosted.org/packages/53/2b/8064d94a6ab6b5c4e643d8535ab6af6cabe5455765540931f0ef60a0bc3b/cupy_cuda12x-13.6.0-cp310-cp310-manylinux2014_x86_64.whl', \
    '/tmp/cupy_cuda12x-13.6.0-cp310-cp310-manylinux2014_x86_64.whl')" && \
    pip install --default-timeout=100000 --no-cache-dir \
        /tmp/cupy_cuda12x-13.6.0-cp310-cp310-manylinux2014_x86_64.whl && \
    rm /tmp/cupy_cuda12x-13.6.0-cp310-cp310-manylinux2014_x86_64.whl

RUN pip install --default-timeout=100000 --no-cache-dir -r requirements.txt

COPY . .

# Output dirs (vast.ai / RunPod mount /workspace as a persistent volume)
RUN mkdir -p /workspace/predictions/v2 /workspace/huggingface_cache

# Run v2 tier inference, tee output to log, then keep container alive for SSH debugging.
# On vast.ai: SSH in and run `tail -f /workspace/run_v2.log` to monitor.
CMD ["sh", "-c", "python step3_modelling/run_realworld_experiments_v2.py 2>&1 | tee /workspace/run_v2.log && echo 'DONE' && sleep infinity"]
